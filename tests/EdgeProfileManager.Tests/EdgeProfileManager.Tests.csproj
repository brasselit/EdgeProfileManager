    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EdgeProfileManager.Core\EdgeProfileManager.Core.csproj" />
  </ItemGroup>

</Project>
