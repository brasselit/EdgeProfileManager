<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bewusst ohne NuGet-Pakete (auf dem Entwicklungsrechner ist keine Paketquelle konfiguriert).
       Ausführen siehe README (dotnet run im Testprojekt). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
