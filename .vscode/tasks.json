{
  "version": "2.0.0",
  "tasks": [
    {
      // Die laufende Tray-Instanz aus bin\Debug beendet der Build selbst (Target StopRunningInstance
      // in EdgeProfileManager.csproj); sonst würde sie DLLs sperren und den Debug-Start per Pipe "schlucken".
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/EdgeProfileManager/EdgeProfileManager.csproj", "-p:GenerateFullPaths=true", "-consoleloggerparameters:NoSummary"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build tests",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/tests/EdgeProfileManager.Tests/EdgeProfileManager.Tests.csproj", "-p:GenerateFullPaths=true", "-consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile"
    }
  ]
}
