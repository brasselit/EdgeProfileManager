<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EdgeProfileManager.Core\EdgeProfileManager.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>EdgeProfileManager.Program</StartupObject>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>Edge Profile Manager</AssemblyTitle>
    <Product>Edge Profile Manager</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI-Awareness kommt bewusst aus dem Manifest, da WPF und nicht WinForms die Anwendung startet. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms (Tray) und WPF (Fenster) teilen viele Typnamen; WinForms nur dort einbinden, wo es gebraucht wird. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
    <!-- Optional: VirtualDesktopAccessor.dll für die Desktop-Zuordnung (siehe README). -->
    <None Include="..\..\lib\VirtualDesktopAccessor.dll" Condition="Exists('..\..\lib\VirtualDesktopAccessor.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>VirtualDesktopAccessor.dll</Link>
    </None>
  </ItemGroup>

  <!--
    Eine laufende Tray-Instanz aus diesem Ausgabeordner sperrt die DLLs. Vor dem Kopieren beenden,
    egal ob der Build aus VS Code, C# Dev Kit oder der Konsole kommt. Instanzen an anderen Orten
    (z.B. eine installierte Release-Version) bleiben unberührt.
  -->
  <Target Name="StopRunningInstance" BeforeTargets="_CopyFilesMarkedCopyLocal;CopyFilesToOutputDirectory"
          Condition="'$(OS)' == 'Windows_NT' And '$(DesignTimeBuild)' != 'true' And Exists('$(TargetDir)$(TargetName).exe')">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -Command &quot;Get-Process '$(TargetName)' -ErrorAction SilentlyContinue | Where-Object { $_.Path -eq '$(TargetDir)$(TargetName).exe' } | ForEach-Object { $_.Kill(); [void]$_.WaitForExit(5000) }&quot;"
          ContinueOnError="true" StandardOutputImportance="low" />
  </Target>

</Project>
