<Window x:Class="EdgeProfileManager.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edge-Profile verwalten" Width="1220" Height="800" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F4F6F7" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C4CDD0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,0,18,6"/></Style>
        <DataTemplate x:Key="ProfileTemplate">
            <Border BorderBrush="{Binding ColorBrush}" BorderThickness="5,0,0,0" Padding="8,10">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding User}" Foreground="#46565C" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Folder}" Foreground="#65777E" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderBrush" Value="#DDE4E6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/>
        </Grid.RowDefinitions>
        <Grid x:Name="WorkArea">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Margin="12,0,0,0" ToolTip="Profile aktualisieren">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;"/>
                </Button>
                <TextBlock Text="Edge-Profile verwalten" FontSize="24" FontWeight="SemiBold" Foreground="#163F43"/>
            </DockPanel>
            <WrapPanel x:Name="Actions" Grid.Row="1" Margin="0,0,0,6"/>
            <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="Drag-and-drop" VerticalAlignment="Center" Margin="0,0,8,6"/>
                <ComboBox x:Name="DropMode" Width="135" Margin="0,0,20,6" Padding="6"/>
                <CheckBox x:Name="LocalOption" Content="Nur lokale Daten" VerticalAlignment="Center"
                          ToolTip="Nur Local Storage, IndexedDB usw. übertragen statt des ganzen Profils."/>
                <CheckBox x:Name="CacheOption" Content="Caches einschliessen" VerticalAlignment="Center"/>
                <CheckBox x:Name="RunningOption" Content="Quelle darf laufen" VerticalAlignment="Center"
                          ToolTip="Backup/Kopie bei geöffnetem Edge; die Kopie kann inkonsistent sein."/>
            </WrapPanel>
            <Grid x:Name="ProfileColumns" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
            </Grid>
        </Grid>
        <TextBlock x:Name="Status" Grid.Row="1" Text="Bereit" Margin="0,12,0,8" Foreground="#163F43" TextWrapping="Wrap"/>
        <TextBox x:Name="Log" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Background="#FFFFFF" BorderBrush="#C4CDD0" Padding="10"/>
    </Grid>
</Window>
