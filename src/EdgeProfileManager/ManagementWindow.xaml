<Window x:Class="EdgeProfileManager.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edge Profile Manager" Width="1280" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F4F6F7" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C4CDD0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0F6C74"/>
            <Setter Property="BorderBrush" Value="#0F6C74"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <!-- Small edit button next to a displayed value (Segoe MDL2 glyph as content). -->
        <Style x:Key="EditButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#0F6C74"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C4CDD0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#DCEEEF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterChip" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="#E3EAEC" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Text" TextElement.Foreground="#2E4247" TextElement.FontSize="12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#163F43"/>
                                <Setter TargetName="Text" Property="TextElement.Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#4F6066"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="KeyLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#4F6066"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KeyValueRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="#EEF2F3"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="5,5"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="6,5"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- Board -->
        <Grid x:Name="WorkArea" Margin="20,16,20,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AddGroupButton" Content="+ Group" Margin="0,0,6,0"/>
                    <Button x:Name="NewProfileButton" Content="+ New profile" Margin="0,0,6,0"/>
                    <Button x:Name="RestoreButton" Content="Restore" Margin="0,0,6,0"/>
                    <Button x:Name="BackupButton" Content="Backup …" Margin="0,0,6,0"/>
                    <Button x:Name="SettingsButton" Margin="0,0,6,0" ToolTip="Settings">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;"/>
                    </Button>
                    <Button x:Name="RefreshButton" ToolTip="Refresh profiles">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;"/>
                    </Button>
                </StackPanel>
                <TextBlock Text="Menu board" FontSize="22" FontWeight="SemiBold" Foreground="#163F43" VerticalAlignment="Center"/>
                <TextBlock Text="Column = group in tray menu · drag card = change group" Foreground="#4F6066" FontSize="12"
                           VerticalAlignment="Center" Margin="12,4,0,0" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                <StackPanel x:Name="Filters" Orientation="Horizontal" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="LocalOption" Content="Local data only" Margin="0,0,16,0"
                              ToolTip="Backup, restore and transfer: only Local Storage, IndexedDB etc. instead of the whole profile."/>
                    <CheckBox x:Name="CacheOption" Content="Include caches" Margin="0,0,16,0"/>
                    <CheckBox x:Name="RunningOption" Content="Allow running source"
                              ToolTip="Backup/copy while Edge is open; the copy may be inconsistent."/>
                </StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Lanes" Orientation="Horizontal"/>
            </ScrollViewer>
        </Grid>

        <!-- Status -->
        <DockPanel Grid.Row="1" Margin="20,0,20,10">
            <Button x:Name="LogButton" DockPanel.Dock="Right" Content="Log" Padding="10,3"/>
            <TextBlock x:Name="Status" Text="Ready" Foreground="#163F43" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Details -->
        <Border Grid.Column="1" Grid.RowSpan="2" Background="#FFFFFF" BorderBrush="#DDE4E6" BorderThickness="1,0,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="#DDE4E6" BorderThickness="0,0,0,1" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Details" FontWeight="SemiBold" Foreground="#163F43"/>
                        <TextBlock x:Name="DetailSubtitle" Foreground="#4F6066" FontSize="12" Margin="10,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailContent" Margin="14,12">
                        <TextBlock x:Name="EmptyHint" Text="Select a card to edit its profile and menu entry." Foreground="#4F6066"
                                   TextWrapping="Wrap" Margin="2,8"/>

                        <!-- Edge profile section -->
                        <Border x:Name="ProfileSection" BorderBrush="#DDE4E6" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                            <StackPanel>
                                <Border Background="#163F43" CornerRadius="7,7,0,0" Padding="12,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="changes Edge itself" Foreground="#CFE0E2" FontSize="12"/>
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="EDGE PROFILE" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                    </DockPanel>
                                </Border>
                                <StackPanel x:Name="ProfileDetails" Margin="12,12,12,10">
                                    <DockPanel Margin="0,0,0,10">
                                        <Grid DockPanel.Dock="Left" Width="64" Height="60" Margin="0,0,10,0">
                                            <Border x:Name="AvatarCircle" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Grid>
                                                    <TextBlock x:Name="AvatarInitials" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image x:Name="AvatarImage" Stretch="UniformToFill">
                                                        <Image.Clip><EllipseGeometry Center="28,28" RadiusX="28" RadiusY="28"/></Image.Clip>
                                                    </Image>
                                                </Grid>
                                            </Border>
                                            <Button x:Name="AvatarButton" Style="{StaticResource EditButton}" Width="24" Height="24" FontSize="10"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" ToolTip="Change avatar" Content="&#xE70F;"/>
                                        </Grid>
                                        <Button x:Name="RenameButton" DockPanel.Dock="Right" Style="{StaticResource EditButton}" ToolTip="Rename"
                                                Content="&#xE70F;" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="ProfileNameText" FontSize="17" FontWeight="SemiBold" Foreground="#163F43" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="ProfileUserText" Foreground="#4F6066" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="RunningText" FontSize="12"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Border Style="{StaticResource KeyValueRow}">
                                        <DockPanel>
                                            <TextBlock Text="Color" Width="62" Style="{StaticResource KeyLabel}"/>
                                            <Button x:Name="ColorButton" DockPanel.Dock="Right" Style="{StaticResource EditButton}" ToolTip="Change color" Content="&#xE70F;"/>
                                            <Ellipse x:Name="ColorSwatch" Width="18" Height="18" Stroke="#C4CDD0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ColorText" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource KeyValueRow}">
                                        <DockPanel>
                                            <TextBlock Text="Channel" Width="62" Style="{StaticResource KeyLabel}"/>
                                            <Button x:Name="TransferButton" DockPanel.Dock="Right" Style="{StaticResource EditButton}"
                                                    ToolTip="Transfer to another channel (copy or move)" Content="&#xE8AB;"/>
                                            <Border Background="#163F43" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock x:Name="ChannelText" Foreground="#FFFFFF" FontSize="11"/>
                                            </Border>
                                            <TextBlock x:Name="FolderText" Foreground="#4F6066" FontSize="12" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource KeyValueRow}">
                                        <DockPanel>
                                            <TextBlock Text="Folder" Width="62" Style="{StaticResource KeyLabel}"/>
                                            <Button x:Name="OpenFolderButton" DockPanel.Dock="Right" Style="{StaticResource EditButton}" ToolTip="Open profile folder" Content="&#xE8A7;"/>
                                            <TextBlock x:Name="PathText" Foreground="#4F6066" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                        </DockPanel>
                                    </Border>
                                    <Border BorderBrush="#EEF2F3" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                        <DockPanel>
                                            <Button x:Name="DeleteButton" DockPanel.Dock="Right" Style="{StaticResource EditButton}" Width="30" Height="30"
                                                    Foreground="#A4262C" BorderBrush="#E3B4B6" ToolTip="Delete profile" Content="&#xE74D;"/>
                                            <Button x:Name="BackupProfileButton" DockPanel.Dock="Right" Content="Backup" Margin="0,0,6,0"/>
                                            <Button x:Name="NewWindowButton" DockPanel.Dock="Right" Content="New window" Margin="0,0,6,0"/>
                                            <Button x:Name="OpenButton" Style="{StaticResource PrimaryButton}" Content="Open" Margin="0,0,6,0"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Menu entry section -->
                        <Border x:Name="MenuSection" BorderBrush="#DDE4E6" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <Border Background="#DCEEEF" CornerRadius="7,7,0,0" Padding="12,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="tray menu and Jump List only" Foreground="#0F4F55" FontSize="12"/>
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE700;" Foreground="#0F4F55" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="MENU ENTRY" Foreground="#0F4F55" FontWeight="Bold" FontSize="12"/>
                                    </DockPanel>
                                </Border>
                                <StackPanel x:Name="InMenuPanel" Margin="12,10,12,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Group" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="GroupCombo"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Label" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="LabelBox" ToolTip="Empty = name of the Edge profile"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Desktop" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="DesktopCombo" IsEditable="True" ToolTip="Number or name of the virtual desktop"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="If window is open" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="ModeCombo"/>
                                        </StackPanel>
                                    </Grid>
                                    <DockPanel Margin="0,12,0,0">
                                        <Button x:Name="RemoveFromMenuButton" DockPanel.Dock="Right" Content="Remove from menu" Foreground="#A4262C"
                                                Background="Transparent" BorderThickness="0" Padding="2" Cursor="Hand"/>
                                        <CheckBox x:Name="JumpListCheck" Content="In Jump List" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel x:Name="NotInMenuPanel" Margin="12,10,12,12">
                                    <TextBlock Text="This profile is not in the menu." Foreground="#4F6066" Margin="0,0,0,8"/>
                                    <TextBlock Text="Add to" Style="{StaticResource FieldLabel}"/>
                                    <DockPanel>
                                        <Button x:Name="AddToMenuButton" DockPanel.Dock="Right" Content="Add" Margin="8,0,0,0"/>
                                        <ComboBox x:Name="AddToGroupCombo"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
